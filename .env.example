# Copia este archivo como .env junto a server.js y completa tu clave localmente.
# No publiques ni envíes .env. Reinicia el servidor después de cambiarlo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tickets de compra. Usa una clave de Resend y un remitente de un dominio verificado.
RESEND_API_KEY=
TIZA_RECEIPT_FROM=

# Dirección pública HTTPS usada en los QR de repartidores. En Render será tu
# URL .onrender.com o tu dominio propio. TIZA_DATA_DIR se configura allí para
# que los pedidos y reseñas vivan en el disco persistente.
TIZA_PUBLIC_ORIGIN=
TIZA_DATA_DIR=

# En Render: correo de Firebase que tendrá el rol de jefe. No escribas aquí
# contraseñas; el acceso siempre se valida con Firebase.
TIZA_OWNER_EMAIL=
